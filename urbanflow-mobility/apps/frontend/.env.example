NEXTAUTH_URL="https://urbanflow.poutoo.dev"
# Générer un secret dédié à la prod (ne jamais réutiliser celui de dev)
NEXTAUTH_SECRET=""

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URL publique du backend déployé sur le VPS (Caddy + reverse proxy)
NEXT_PUBLIC_API_URL="https://api-urbanflow.poutoo.dev/api"

# Clé CARTO pour le fond de carte Leaflet (Positron / Dark Matter). Gratuite,
# sans validation : https://carto.com/basemaps/apikey. Depuis fin août 2026,
# les tuiles CARTO non authentifiées sont tatouées « API KEY REQUIRED ».
# Sans cette variable, l'app se rabat sur les tuiles OpenStreetMap (clair seul).
NEXT_PUBLIC_CARTO_API_KEY=""
